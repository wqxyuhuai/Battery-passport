@font-face {
  font-family: 'SF Pro';
  src: url('./assets/fonts/SFPro-Variable.woff2') format('woff2');
  font-weight: 1 1000;
  font-style: normal;
  font-display: swap;
}

:root {
  --canvas: #0f1012;
  --surface: #16181c;
  --surface-hover: #1c1f24;
  --hairline: rgba(255, 255, 255, 0.075);
  --hairline-strong: rgba(255, 255, 255, 0.14);
  --ink: #f4f5f7;
  --ink-muted: #c2c6cd;
  --ink-subtle: #8f959f;
  --ink-tertiary: #6c727c;
  --primary: #5e6ad2;
  --primary-hover: #8b95ff;
  --success: #47a45e;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --font-sans: 'SF Pro', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', -apple-system,
    BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'SF Pro', 'PingFang SC', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont,
    'Segoe UI', sans-serif;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  background: var(--canvas);
  color-scheme: dark;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--canvas);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-feature-settings: 'kern' 1, 'liga' 1;
}

button,
input,
select {
  font: inherit;
  color: inherit;
}

button {
  appearance: none;
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

svg {
  flex: 0 0 auto;
}

::selection {
  background: rgba(94, 106, 210, 0.4);
  color: var(--ink);
}

:focus-visible {
  outline: 2px solid var(--primary-hover);
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: fixed;
  z-index: 200;
  top: 14px;
  left: 14px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--ink);
  color: var(--canvas);
  font-size: 15px;
  transform: translateY(-180%);
  transition: transform 180ms var(--ease);
}

.skip-link:focus {
  transform: translateY(0);
}

/* ---------- Shell ---------- */

.app {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 268px minmax(0, 1fr);
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 30px;
  padding: 30px 22px 26px;
  border-right: 1px solid var(--hairline);
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--hairline-strong) transparent;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 6px;
}

.brand-mark {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 8px;
  background: var(--primary);
  color: #fff;
}

.brand-wordmark {
  display: flex;
  flex-direction: column;
  gap: 1px;
  line-height: 1.3;
}

.brand-name {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.015em;
}

.brand-sub {
  color: var(--ink-tertiary);
  font-size: 13px;
}

.product-chip {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 6px;
}

.product-chip-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--ink-subtle);
}

.product-chip-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.product-chip-name {
  overflow: hidden;
  color: var(--ink-muted);
  font-size: 14.5px;
  font-weight: 550;
  letter-spacing: -0.01em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-chip-meta {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--ink-tertiary);
  font-size: 13px;
}

.status-dot {
  width: 6px;
  height: 6px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: var(--success);
}

.sidebar-label {
  padding: 0 8px;
  margin-bottom: -20px;
  color: var(--ink-tertiary);
  font-size: 12.5px;
  font-weight: 550;
  letter-spacing: 0.03em;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  min-height: 40px;
  padding: 8px 8px;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--ink-subtle);
  font-size: 15px;
  text-align: left;
  transition: background 150ms var(--ease), color 150ms var(--ease);
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.04);
  color: var(--ink-muted);
}

.nav-item[aria-current='page'] {
  background: rgba(255, 255, 255, 0.065);
  color: var(--ink);
}

.nav-item-icon {
  display: grid;
  place-items: center;
  width: 20px;
  height: 20px;
  color: var(--ink-tertiary);
}

.nav-item[aria-current='page'] .nav-item-icon {
  color: var(--ink-subtle);
}

.nav-item-label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-spacer {
  flex: 1;
  min-height: 20px;
}

.sidebar-footer {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 8px;
  color: var(--ink-tertiary);
  font-size: 13px;
}

.sidebar-footer strong {
  color: var(--ink-subtle);
  font-weight: 550;
}

.main {
  min-width: 0;
}

/* ---------- Top bar ---------- */

.topbar {
  position: sticky;
  top: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 16px;
  height: 64px;
  padding: 0 56px;
  border-bottom: 1px solid var(--hairline);
  background: rgba(15, 16, 18, 0.88);
  backdrop-filter: blur(18px) saturate(120%);
}

.breadcrumbs {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--ink-tertiary);
  font-size: 14px;
}

.breadcrumbs-current {
  overflow: hidden;
  color: var(--ink-subtle);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar-spacer {
  flex: 1;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 22px;
}

.icon-button {
  display: inline-grid;
  place-items: center;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--ink-subtle);
  transition: background 150ms var(--ease), color 150ms var(--ease);
}

.icon-button:hover {
  background: var(--surface);
  color: var(--ink);
}

.mobile-menu {
  display: none;
}

/* ---------- Language menu ---------- */

.language {
  position: relative;
}

.language-trigger {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 36px;
  padding: 0 4px;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink-muted);
  font-size: 14.5px;
  transition: color 150ms var(--ease);
}

.language-trigger:hover,
.language-trigger[aria-expanded='true'] {
  color: var(--ink);
}

.language-trigger svg {
  color: var(--ink-tertiary);
}

.language-trigger:hover svg,
.language-trigger[aria-expanded='true'] svg {
  color: var(--ink-subtle);
}

.language-caret {
  transition: transform 160ms var(--ease);
}

.language-trigger[aria-expanded='true'] .language-caret {
  transform: rotate(180deg);
}

.language-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  z-index: 90;
  width: 196px;
  padding: 6px;
  border: 1px solid var(--hairline-strong);
  border-radius: var(--radius-lg);
  background: #1a1c21;
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.35);
  animation: menu-in 150ms var(--ease);
}

.language-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: 38px;
  padding: 8px 10px;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink-muted);
  font-size: 14.5px;
  text-align: left;
  transition: background 120ms var(--ease), color 120ms var(--ease);
}

.language-option:hover,
.language-option:focus-visible {
  background: rgba(255, 255, 255, 0.06);
  color: var(--ink);
  outline: none;
}

.language-option[aria-selected='true'] {
  color: var(--ink);
  font-weight: 560;
}

.language-option svg {
  color: var(--primary-hover);
}

@keyframes menu-in {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ---------- Buttons ---------- */

.action-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 38px;
  padding: 0 16px;
  border: 0;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: #fff;
  font-size: 14.5px;
  font-weight: 550;
  white-space: nowrap;
  transition: background 150ms var(--ease), color 150ms var(--ease);
}

.action-button:hover {
  background: #6d79e0;
}

.action-button--secondary {
  padding: 0 6px;
  background: transparent;
  color: var(--ink-subtle);
  font-weight: 500;
}

.action-button--secondary:hover {
  background: transparent;
  color: var(--ink);
}

/* ---------- Content ---------- */

.content {
  padding: 56px 56px 72px;
}

.hero {
  max-width: 1120px;
  padding-bottom: 52px;
}

.hero-eyebrow {
  display: inline-block;
  color: var(--ink-tertiary);
  font-size: 13px;
  font-weight: 550;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero-head {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 14px;
}

.hero-title {
  margin: 0;
  font-size: clamp(38px, 3.6vw, 52px);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  padding: 4px 11px 4px 9px;
  border-radius: 999px;
  background: rgba(71, 164, 94, 0.12);
  color: #7bd08f;
  font-size: 13px;
  font-weight: 550;
  white-space: nowrap;
}

.hero-description {
  max-width: 620px;
  margin: 18px 0 0;
  color: var(--ink-subtle);
  font-size: 16.5px;
  line-height: 1.65;
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 32px;
  margin: 40px 0 0;
}

.hero-meta dt {
  color: var(--ink-tertiary);
  font-size: 13.5px;
}

.hero-meta dd {
  margin: 6px 0 0;
  color: var(--ink-muted);
  font-size: 16px;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.005em;
}

/* ---------- Metrics ---------- */

.metrics {
  max-width: 1120px;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 32px;
  padding: 30px 0 34px;
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.metric-label {
  color: var(--ink-tertiary);
  font-size: 13.5px;
  line-height: 1.35;
}

.metric-value {
  display: flex;
  align-items: baseline;
  gap: 5px;
  min-width: 0;
}

.metric-value strong {
  font-size: 33px;
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
}

.metric-unit {
  color: var(--ink-tertiary);
  font-size: 14px;
  font-weight: 450;
}

/* ---------- Workspace ---------- */

.workspace {
  max-width: 1120px;
}

.panel {
  padding-top: 64px;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.panel-title {
  margin: 0;
  font-size: 24px;
  font-weight: 580;
  letter-spacing: -0.025em;
}

.panel-tools {
  display: flex;
  align-items: center;
  gap: 12px;
}

.search {
  position: relative;
  display: flex;
  align-items: center;
  width: 260px;
}

.search-icon {
  position: absolute;
  left: 13px;
  color: var(--ink-tertiary);
  pointer-events: none;
}

.search-input {
  width: 100%;
  height: 40px;
  padding: 0 38px 0 39px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  background: var(--surface);
  color: var(--ink);
  font-size: 14.5px;
  transition: border-color 150ms var(--ease), background 150ms var(--ease);
}

.search-input::placeholder {
  color: var(--ink-tertiary);
}

.search-input:hover {
  background: var(--surface-hover);
}

.search-input:focus {
  outline: none;
  border-color: var(--hairline-strong);
  background: var(--surface-hover);
}

.search-input::-webkit-search-cancel-button {
  display: none;
}

.search-clear {
  position: absolute;
  right: 8px;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink-tertiary);
}

.search-clear:hover {
  background: rgba(255, 255, 255, 0.06);
  color: var(--ink-muted);
}

.tabbar {
  display: flex;
  align-items: center;
  gap: 30px;
  margin-top: 30px;
  border-bottom: 1px solid var(--hairline);
  overflow-x: auto;
  scrollbar-width: none;
}

.tabbar::-webkit-scrollbar {
  display: none;
}

.tab {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  padding: 0 0 14px;
  border: 0;
  border-bottom: 1.5px solid transparent;
  margin-bottom: -1px;
  background: transparent;
  color: var(--ink-tertiary);
  font-size: 15px;
  white-space: nowrap;
  transition: color 150ms var(--ease), border-color 150ms var(--ease);
}

.tab:hover {
  color: var(--ink-muted);
}

.tab[aria-selected='true'] {
  border-bottom-color: var(--ink);
  color: var(--ink);
}

.panel-body {
  padding-top: 36px;
}

.panel-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 4px;
}

.panel-heading {
  margin: 0;
  font-size: 19px;
  font-weight: 580;
  letter-spacing: -0.02em;
}

/* ---------- Sections and fields ---------- */

.section-list {
  display: flex;
  flex-direction: column;
  gap: 48px;
  margin-top: 34px;
}

.section-head {
  margin-bottom: 20px;
}

.section-title {
  margin: 0;
  color: var(--ink-muted);
  font-size: 15px;
  font-weight: 580;
  letter-spacing: -0.005em;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 64px;
  row-gap: 28px;
}

.field {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.field--wide {
  grid-column: 1 / -1;
}

.field-label {
  color: var(--ink-tertiary);
  font-size: 13.5px;
  line-height: 1.45;
}

.field-value {
  color: var(--ink);
  font-size: 16px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.field-value--mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.002em;
}

.field-value--strong {
  font-weight: 550;
}

.field-lines {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.field-kv {
  display: grid;
  grid-template-columns: minmax(120px, 0.42fr) minmax(0, 1fr);
  gap: 16px;
  padding: 2px 0;
}

.field-kv-key {
  color: var(--ink-subtle);
  font-size: 14.5px;
}

.field-kv-value {
  color: var(--ink-muted);
  font-size: 15.5px;
  overflow-wrap: anywhere;
}

.field-locked {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--ink-subtle);
}

.field-awaiting-value {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--ink-tertiary);
}

.field-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--ink-muted);
  transition: color 150ms var(--ease);
}

.field-link:hover {
  color: var(--primary-hover);
}

.field-link-icon {
  display: grid;
  place-items: center;
  color: var(--ink-tertiary);
}

.field-link:hover .field-link-icon {
  color: inherit;
}

.field-link-text {
  text-decoration: underline;
  text-decoration-color: var(--hairline-strong);
  text-underline-offset: 4px;
}

.field-link:hover .field-link-text {
  text-decoration-color: currentColor;
}

.inline-link {
  color: var(--ink-muted);
  text-decoration: underline;
  text-decoration-color: var(--hairline-strong);
  text-underline-offset: 3px;
}

.inline-link:hover {
  color: var(--primary-hover);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 11px;
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink-muted);
  font-size: 14.5px;
}

.chip-dot {
  width: 5px;
  height: 5px;
  border-radius: 999px;
  background: var(--ink-tertiary);
}

/* ---------- Notice ---------- */

.notice {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  margin-top: 28px;
  padding: 18px 20px;
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.notice-icon {
  display: grid;
  place-items: center;
  margin-top: 1px;
  color: var(--ink-subtle);
}

.notice-title {
  font-size: 15px;
  font-weight: 550;
}

.notice-text {
  margin: 4px 0 0;
  color: var(--ink-subtle);
  font-size: 14.5px;
  line-height: 1.6;
}

.notice--muted {
  background: transparent;
  padding: 0;
}

/* ---------- Empty ---------- */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72px 24px;
  text-align: center;
}

.empty-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  background: var(--surface);
  color: var(--ink-subtle);
}

.empty-title {
  margin: 20px 0 0;
  font-size: 17px;
  font-weight: 550;
}

.empty-text {
  max-width: 380px;
  margin: 8px 0 22px;
  color: var(--ink-subtle);
  font-size: 14.5px;
  line-height: 1.6;
}

/* ---------- Record band ---------- */

.record {
  max-width: 1120px;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) minmax(0, 1fr);
  gap: 56px;
  margin-top: 80px;
  padding-top: 40px;
  border-top: 1px solid var(--hairline);
}

.record-col {
  min-width: 0;
}

.record-title {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0;
  color: var(--ink-muted);
  font-size: 14.5px;
  font-weight: 560;
}

.record-title svg {
  color: var(--success);
}

.record-lead {
  margin: 12px 0 0;
  color: var(--ink);
  font-size: 16px;
  font-variant-numeric: tabular-nums;
}

.record-lead strong {
  font-size: 21px;
  font-weight: 550;
  letter-spacing: -0.02em;
}

.record-facts {
  margin: 20px 0 0;
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.record-facts div {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
}

.record-facts dt {
  color: var(--ink-tertiary);
  font-size: 13.5px;
}

.record-facts dd {
  margin: 0;
  color: var(--ink-muted);
  font-size: 14.5px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.record-note {
  margin: 10px 0 0;
  color: var(--ink-tertiary);
  font-size: 14px;
  line-height: 1.55;
}

.record-col--aside {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.record-qr {
  flex: 0 0 auto;
  padding: 8px;
  border-radius: var(--radius-md);
  background: #fff;
  line-height: 0;
}

.record-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 14px;
  color: var(--ink-muted);
  font-size: 14.5px;
  transition: color 150ms var(--ease);
}

.record-link:hover {
  color: var(--primary-hover);
}

.meter {
  height: 3px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.09);
}

.meter--slim {
  width: 100%;
  max-width: 260px;
  margin-top: 14px;
}

.meter-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
}

/* ---------- Footer ---------- */

.footer {
  max-width: 1120px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 64px;
  color: var(--ink-tertiary);
  font-size: 13.5px;
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 22px;
}

.footer-links a:hover {
  color: var(--ink-muted);
}

/* ---------- Toast ---------- */

.toast {
  position: fixed;
  left: 50%;
  bottom: 32px;
  z-index: 120;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 11px 18px;
  border-radius: 999px;
  background: #f4f5f7;
  color: #101114;
  font-size: 14.5px;
  font-weight: 550;
  transform: translateX(-50%);
  animation: toast-in 220ms var(--ease);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translate(-50%, 8px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.mobile-overlay {
  display: none;
}

/* ---------- Responsive ---------- */

@media (max-width: 1180px) {
  .topbar {
    padding: 0 36px;
  }

  .content {
    padding: 48px 36px 64px;
  }

  .field-grid {
    column-gap: 44px;
  }

  .record {
    gap: 36px;
  }
}

@media (max-width: 1024px) {
  .app {
    grid-template-columns: 236px minmax(0, 1fr);
  }

  .sidebar {
    padding: 26px 16px 22px;
  }

  .metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 28px;
  }

  .record {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .record-col--aside {
    grid-column: 1 / -1;
  }
}

@media (max-width: 860px) {
  .app {
    grid-template-columns: minmax(0, 1fr);
  }

  .sidebar {
    position: fixed;
    z-index: 100;
    top: 0;
    bottom: 0;
    left: 0;
    width: 272px;
    height: 100dvh;
    background: #121316;
    transform: translateX(-100%);
    transition: transform 240ms var(--ease);
  }

  .app[data-nav-open='true'] .sidebar {
    transform: translateX(0);
  }

  .mobile-overlay {
    position: fixed;
    z-index: 90;
    inset: 0;
    display: block;
    border: 0;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease);
  }

  .app[data-nav-open='true'] .mobile-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu {
    display: inline-grid;
  }

  .topbar {
    padding: 0 20px;
    gap: 10px;
  }

  .breadcrumbs span:first-child,
  .breadcrumbs span[aria-hidden='true'] {
    display: none;
  }

  .content {
    padding: 36px 20px 56px;
  }

  .hero {
    padding-bottom: 40px;
  }

  .hero-meta {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 28px;
    margin-top: 32px;
  }

  .panel {
    padding-top: 48px;
  }

  .panel-head {
    flex-direction: column;
    align-items: stretch;
  }

  .search {
    width: 100%;
  }
}

@media (max-width: 720px) {
  .topbar-actions {
    gap: 12px;
  }

  .action-button--secondary span {
    display: none;
  }

  .action-button--secondary {
    padding: 0 8px;
  }

  .hero-head {
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-title {
    font-size: 34px;
  }

  .hero-description {
    font-size: 15.5px;
  }

  .metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 24px;
    padding: 26px 0 28px;
  }

  .metric-value strong {
    font-size: 27px;
  }

  .field-grid {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 24px;
  }

  .field-kv {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }

  .tabbar {
    gap: 22px;
  }

  .tab {
    font-size: 14px;
  }

  .record {
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    margin-top: 56px;
  }

  .record-col--aside {
    grid-column: auto;
  }

  .footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 48px;
  }
}
