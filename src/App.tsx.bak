import {
  ArrowUpRight,
  BatteryCharging,
  CaretDown,
  Check,
  CheckCircle,
  Copy,
  DownloadSimple,
  FileText,
  Gauge,
  Globe,
  Heartbeat,
  IconContext,
  Leaf,
  Lock,
  MagnifyingGlass,
  Minus,
  Pulse,
  ShieldCheck,
  X,
} from '@phosphor-icons/react'
import type { ComponentType, KeyboardEvent, ReactNode } from 'react'
import { useEffect, useMemo, useRef, useState } from 'react'
import { QRCodeSVG } from 'qrcode.react'
import './print.css'
import {
  findFieldAcross,
  getPanel,
  getPanels,
  isKeyValueLine,
  LANGS,
  LANG_LABELS,
  METRIC_KEYS,
  METRICS,
  splitKeyValue,
  splitLines,
  splitMetric,
  TAB_KEYS,
  UI,
  type Field,
  type Lang,
  type Panel,
  type Section,
  type TabKey,
} from './data/passport'

type IconProps = { size?: number; weight?: 'thin' | 'light' | 'regular' | 'bold' | 'fill' | 'duotone'; className?: string }
type IconComponent = ComponentType<IconProps>

const LOCALE: Record<Lang, string> = { zh: 'zh-CN', en: 'en-GB', de: 'de-DE' }
const PRODUCT_NAME = 'Wattsonic Li-LV 5.0'
const SUPPORT_EMAIL = 'info@wattsonic.com'
const ICON_DEFAULTS = { weight: 'fill', size: 20 } as const

const TAB_ICONS: Record<TabKey, IconComponent> = {
  basic: BatteryCharging,
  performance: Gauge,
  materials: Leaf,
  health: Heartbeat,
  compliance: ShieldCheck,
}

const MONO_FIELDS = new Set(['001', '005', '006', '007', '008', '010', '011', '012'])
const STRUCTURED_FIELDS = new Set(['009', '014', '015', '042', '043', '044'])

function formatMetricNumber(raw: string, lang: Lang): string {
  if (!raw) return '—'
  const normalized = raw.replace(',', '.')
  if (!normalized.includes('.')) {
    const value = Number(normalized.replace(/[^\d-]/g, ''))
    if (Number.isFinite(value)) return new Intl.NumberFormat(LOCALE[lang]).format(value)
  }
  return raw
}

async function copyToClipboard(text: string) {
  if (navigator.clipboard?.writeText) {
    await navigator.clipboard.writeText(text)
    return
  }
  const textarea = document.createElement('textarea')
  textarea.value = text
  textarea.style.position = 'fixed'
  textarea.style.opacity = '0'
  document.body.appendChild(textarea)
  textarea.select()
  document.execCommand('copy')
  textarea.remove()
}

function BrandMark({ size = 32 }: { size?: number }) {
  return (
    <span className="brand-mark" style={{ width: size, height: size }} aria-hidden="true">
      <svg width={size * 0.58} height={size * 0.58} viewBox="0 0 32 32" fill="none">
        <path
          d="M5 8.5l5.1 15L16 8.5l5.9 15L27 8.5"
          stroke="currentColor"
          strokeWidth="3.1"
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      </svg>
    </span>
  )
}

function DocButton({ field }: { field: Field }) {
  return (
    <a
      className="field-link"
      href={field.href ?? '#'}
      target="_blank"
      rel="noreferrer noopener"
      aria-label={`${field.label} · ${field.value}`}
    >
      <span className="field-link-icon">
        <FileText size={18} />
      </span>
      <span className="field-link-text">{field.value}</span>
      <ArrowUpRight size={16} />
    </a>
  )
}

function PlainLines({ lines }: { lines: string[] }) {
  return (
    <span className="field-lines">
      {lines.map((line, index) => (
        <span key={`${line}-${index}`}>{line}</span>
      ))}
    </span>
  )
}

function StructuredLines({ lines }: { lines: string[] }) {
  return (
    <span className="field-lines">
      {lines.map((line, index) => {
        if (!isKeyValueLine(line)) return <span key={`${line}-${index}`}>{line}</span>
        const [key, value] = splitKeyValue(line)
        const content: ReactNode =
          value.startsWith('http://') || value.startsWith('https://') ? (
            <a className="inline-link" href={value} target="_blank" rel="noreferrer noopener">
              {value}
            </a>
          ) : value.includes('@') && !value.includes(' ') ? (
            <a className="inline-link" href={`mailto:${value}`}>
              {value}
            </a>
          ) : (
            value
          )
        return (
          <span className="field-kv" key={`${line}-${index}`}>
            <span className="field-kv-key">{key}</span>
            <span className="field-kv-value">{content}</span>
          </span>
        )
      })}
    </span>
  )
}

function FieldCard({ field, ui }: { field: Field; ui: (typeof UI)[Lang] }) {
  const lines = splitLines(field.value)
  const wide =
    STRUCTURED_FIELDS.has(field.id) || lines.length > 2 || field.value.length > 108
  const isMono = MONO_FIELDS.has(field.id)
  const isAwaiting = field.value.trim() === '--' || field.value.trim() === '—'

  let valueNode: ReactNode
  if (field.locked) {
    valueNode = (
      <span className="field-locked">
        <Lock size={16} />
        {field.value}
      </span>
    )
  } else if (field.href) {
    valueNode = <DocButton field={field} />
  } else if (isAwaiting) {
    valueNode = (
      <span className="field-awaiting">
        <span className="field-awaiting-value">
          <Minus size={16} /> {ui.awaitingData}
        </span>
      </span>
    )
  } else if (field.id === '042' || field.id === '009') {
    valueNode = (
      <span className="chips">
        {lines.map((line, index) => (
          <span className="chip" key={`${line}-${index}`}>
            <span className="chip-dot" />
            {line}
          </span>
        ))}
      </span>
    )
  } else if (lines.length > 1 && lines.some(isKeyValueLine)) {
    valueNode = <StructuredLines lines={lines} />
  } else if (lines.length > 1) {
    valueNode = <PlainLines lines={lines} />
  } else {
    valueNode = field.value
  }

  return (
    <article className={`field${wide ? ' field--wide' : ''}`}>
      <div className="field-label">{field.label}</div>
      <div
        className={[
          'field-value',
          isMono ? 'field-value--mono' : '',
          field.id === '002' ? 'field-value--strong' : '',
        ]
          .filter(Boolean)
          .join(' ')}
      >
        {valueNode}
      </div>
    </article>
  )
}

function SectionBlock({ section, id, ui }: { section: Section; id: string; ui: (typeof UI)[Lang] }) {
  return (
    <section className="section" id={id} aria-label={section.title}>
      <div className="section-head">
        <h4 className="section-title">{section.title}</h4>
      </div>
      <div className="field-grid">
        {section.fields.map((field) => (
          <FieldCard key={field.id} field={field} ui={ui} />
        ))}
      </div>
    </section>
  )
}

function PrintValue({ field }: { field: Field }) {
  return (
    <div className="print-field">
      <div className="print-field-label">{field.label}</div>
      <div className="print-field-value">
        {field.value.split('\n').map((line, index) => (
          <span key={`${line}-${index}`}>{line}</span>
        ))}
        {field.href && <a href={field.href}>{field.href}</a>}
      </div>
    </div>
  )
}

function PrintDocument({
  lang,
  panels,
  identity,
  metrics,
}: {
  lang: Lang
  panels: Panel[]
  identity: { dppId: string; serial: string; model: string; updated: string; status: string }
  metrics: Array<{ label: string; value: string; unit: string }>
}) {
  const ui = UI[lang]
  const generated = new Intl.DateTimeFormat(LOCALE[lang], {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(new Date())

  return (
    <div className="print-document" aria-hidden="true">
      <header className="print-header">
        <div className="print-brand">
          <BrandMark size={28} />
          <div>
            <strong>{ui.brand}</strong>
            <span>{ui.product}</span>
          </div>
        </div>
        <div className="print-stamp">
          <CheckCircle size={16} />
          {ui.confirmed}
        </div>
      </header>

      <div className="print-eyebrow">{ui.eyebrow}</div>
      <h1 className="print-title">{PRODUCT_NAME}</h1>
      <p className="print-subtitle">{ui.printTitle}</p>

      <dl className="print-identity">
        <div>
          <dt>{ui.dppId}</dt>
          <dd>{identity.dppId}</dd>
        </div>
        <div>
          <dt>{ui.serial}</dt>
          <dd>{identity.serial}</dd>
        </div>
        <div>
          <dt>{ui.model}</dt>
          <dd>{identity.model}</dd>
        </div>
        <div>
          <dt>{ui.updated}</dt>
          <dd>{identity.updated}</dd>
        </div>
      </dl>

      <div className="print-metrics">
        {metrics.map((metric) => (
          <div className="print-metric" key={metric.label}>
            <span>{metric.label}</span>
            <strong>
              {metric.value} <small>{metric.unit}</small>
            </strong>
          </div>
        ))}
      </div>

      {panels.map((panel) => (
        <section className="print-panel" key={panel.title}>
          <h2>{panel.title}</h2>
          {panel.sections.map((section) => (
            <div className="print-section" key={section.title}>
              <h3>{section.title}</h3>
              <div className="print-fields">
                {section.fields.map((field) => (
                  <PrintValue field={field} key={field.id} />
                ))}
              </div>
            </div>
          ))}
        </section>
      ))}

      <footer className="print-footer">
        <span>{ui.printFooter}</span>
        <span>
          {ui.generated}: {generated}
        </span>
      </footer>
    </div>
  )
}

export default function App() {
  const [lang, setLang] = useState<Lang>(() => {
    const saved = window.localStorage.getItem('wattsonic-passport-lang')
    return LANGS.includes(saved as Lang) ? (saved as Lang) : 'zh'
  })
  const [tab, setTab] = useState<TabKey>('basic')
  const [search, setSearch] = useState('')
  const [copied, setCopied] = useState(false)
  const [langOpen, setLangOpen] = useState(false)
  const [searchOpen, setSearchOpen] = useState(false)
  const langWrapRef = useRef<HTMLDivElement>(null)
  const langTriggerRef = useRef<HTMLButtonElement>(null)
  const langOptionRefs = useRef<Array<HTMLButtonElement | null>>([])
  const searchWrapRef = useRef<HTMLDivElement>(null)
  const searchTriggerRef = useRef<HTMLButtonElement>(null)
  const searchInputRef = useRef<HTMLInputElement>(null)
  const tabRefs = useRef<Array<HTMLButtonElement | null>>([])
  const toastTimer = useRef<number | undefined>(undefined)

  const ui = UI[lang]
  const panels = useMemo(() => getPanels(lang), [lang])
  const activePanel = useMemo(() => getPanel(lang, tab), [lang, tab])

  useEffect(() => {
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang === 'de' ? 'de' : 'en'
    window.localStorage.setItem('wattsonic-passport-lang', lang)
    document.title = `${ui.brand} · ${ui.product} · ${PRODUCT_NAME}`
  }, [lang, ui.brand, ui.product])

  useEffect(() => () => window.clearTimeout(toastTimer.current), [])

  useEffect(() => {
    if (!langOpen) return
    function onPointerDown(event: PointerEvent) {
      if (!langWrapRef.current?.contains(event.target as Node)) setLangOpen(false)
    }
    function onEscape(event: globalThis.KeyboardEvent) {
      if (event.key === 'Escape') {
        setLangOpen(false)
        langTriggerRef.current?.focus()
      }
    }
    document.addEventListener('pointerdown', onPointerDown)
    document.addEventListener('keydown', onEscape)
    return () => {
      document.removeEventListener('pointerdown', onPointerDown)
      document.removeEventListener('keydown', onEscape)
    }
  }, [langOpen])

  useEffect(() => {
    if (!searchOpen) return
    function onPointerDown(event: PointerEvent) {
      if (!searchWrapRef.current?.contains(event.target as Node)) setSearchOpen(false)
    }
    function onEscape(event: globalThis.KeyboardEvent) {
      if (event.key === 'Escape') {
        setSearchOpen(false)
        searchTriggerRef.current?.focus()
      }
    }
    document.addEventListener('pointerdown', onPointerDown)
    document.addEventListener('keydown', onEscape)
    return () => {
      document.removeEventListener('pointerdown', onPointerDown)
      document.removeEventListener('keydown', onEscape)
    }
  }, [searchOpen])

  useEffect(() => {
    if (searchOpen) searchInputRef.current?.focus()
  }, [searchOpen])

  useEffect(() => {
    if (!langOpen) return
    const index = LANGS.indexOf(lang)
    const timer = window.setTimeout(() => langOptionRefs.current[index]?.focus(), 0)
    return () => window.clearTimeout(timer)
  }, [langOpen, lang])

  const identity = useMemo(
    () => ({
      dppId: findFieldAcross(lang, '005')?.value ?? 'DPP-2027-A001',
      serial: findFieldAcross(lang, '011')?.value ?? 'A001',
      model: findFieldAcross(lang, '010')?.value ?? 'WTS-LiLV-5.12',
      updated: findFieldAcross(lang, '004')?.value ?? '',
      status: findFieldAcross(lang, '002')?.value ?? '',
    }),
    [lang],
  )

  const metrics = useMemo(
    () =>
      METRIC_KEYS.map((key) => {
        const field = findFieldAcross(lang, METRICS[key])
        const parsed = splitMetric(field?.value ?? '')
        return {
          key,
          label: ui.metricSubtitles[key],
          value: formatMetricNumber(parsed.number, lang),
          unit: parsed.unit,
        }
      }),
    [lang, ui],
  )

  const allFields = useMemo(() => panels.flatMap((panel) => panel.sections.flatMap((s) => s.fields)), [panels])
  const query = search.trim().toLowerCase()
  const filteredSections = useMemo(
    () =>
      activePanel.sections
        .map((section) => {
          if (!query) return section
          const sectionHit = section.title.toLowerCase().includes(query)
          return {
            ...section,
            fields: sectionHit
              ? section.fields
              : section.fields.filter((field) =>
                  `${field.label} ${field.value} ${field.id}`.toLowerCase().includes(query),
                ),
          }
        })
        .filter((section) => section.fields.length > 0),
    [activePanel, query],
  )
  const matchCount = filteredSections.reduce((sum, section) => sum + section.fields.length, 0)

  const shareUrl =
    typeof window !== 'undefined' ? window.location.href : 'https://passport.wattsonic.com'

  function selectTab(next: TabKey, shouldScroll = true) {
    setTab(next)
    setSearch('')
    if (shouldScroll) {
      window.setTimeout(() => {
        document.getElementById('passport-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }, 20)
    }
  }

  function onTabKeyDown(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    let nextIndex = index
    if (event.key === 'ArrowRight') nextIndex = (index + 1) % TAB_KEYS.length
    else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + TAB_KEYS.length) % TAB_KEYS.length
    else if (event.key === 'Home') nextIndex = 0
    else if (event.key === 'End') nextIndex = TAB_KEYS.length - 1
    else return
    event.preventDefault()
    const next = TAB_KEYS[nextIndex]
    setTab(next)
    setSearch('')
    window.setTimeout(() => tabRefs.current[nextIndex]?.focus(), 0)
  }

  function chooseLang(next: Lang) {
    setLang(next)
    setLangOpen(false)
    langTriggerRef.current?.focus()
  }

  function onLangMenuKeyDown(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    let nextIndex = index
    if (event.key === 'ArrowDown') nextIndex = (index + 1) % LANGS.length
    else if (event.key === 'ArrowUp') nextIndex = (index - 1 + LANGS.length) % LANGS.length
    else if (event.key === 'Home') nextIndex = 0
    else if (event.key === 'End') nextIndex = LANGS.length - 1
    else if (event.key === 'Escape') {
      event.preventDefault()
      setLangOpen(false)
      langTriggerRef.current?.focus()
      return
    } else if (event.key === 'Tab') {
      setLangOpen(false)
      return
    } else return
    event.preventDefault()
    langOptionRefs.current[nextIndex]?.focus()
  }

  async function handleCopy() {
    try {
      await copyToClipboard(shareUrl)
      setCopied(true)
      window.clearTimeout(toastTimer.current)
      toastTimer.current = window.setTimeout(() => setCopied(false), 2200)
    } catch {
      setCopied(false)
    }
  }

  function handlePrint() {
    window.setTimeout(() => window.print(), 60)
  }

  return (
    <IconContext.Provider value={ICON_DEFAULTS}>
    <>
      <a className="skip-link" href="#passport-panel">
        {lang === 'zh' ? '跳到护照内容' : lang === 'de' ? 'Zum Batteriepass springen' : 'Skip to passport content'}
      </a>

      <div className="app">
        <main className="main">
          <div className="topbar">
            <a className="topbar-brand" href="https://www.wattsonic.com" target="_blank" rel="noreferrer noopener">
              <BrandMark size={30} />
              <span className="topbar-brand-copy">
                <span className="topbar-brand-name">{ui.brand}</span>
                <span className="topbar-brand-sub">{ui.product}</span>
              </span>
            </a>

            <span className="topbar-divider" aria-hidden="true" />

            <div className="topbar-product">
              <span>{PRODUCT_NAME}</span>
              <span className="topbar-serial">{identity.serial}</span>
            </div>
            <div className="topbar-spacer" />

            <div className="topbar-actions">
              <div className="language" ref={langWrapRef}>
                <button
                  ref={langTriggerRef}
                  className="language-trigger"
                  type="button"
                  aria-haspopup="listbox"
                  aria-expanded={langOpen}
                  aria-label={lang === 'zh' ? '选择显示语言' : 'Select display language'}
                  onClick={() => setLangOpen((open) => !open)}
                  onKeyDown={(event) => {
                    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                      event.preventDefault()
                      setLangOpen(true)
                    }
                  }}
                >
                  <Globe size={17} />
                  <span>{LANG_LABELS[lang]}</span>
                  <CaretDown size={14} weight="bold" className="language-caret" />
                </button>
                {langOpen && (
                  <div
                    className="language-menu"
                    role="listbox"
                    aria-label={lang === 'zh' ? '显示语言' : 'Display language'}
                  >
                    {LANGS.map((item, index) => (
                      <button
                        className="language-option"
                        type="button"
                        role="option"
                        aria-selected={item === lang}
                        key={item}
                        ref={(node) => {
                          langOptionRefs.current[index] = node
                        }}
                        onClick={() => chooseLang(item)}
                        onKeyDown={(event) => onLangMenuKeyDown(event, index)}
                      >
                        <span>{LANG_LABELS[item]}</span>
                        {item === lang && <Check size={16} weight="bold" />}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <button className="action-button action-button--secondary" type="button" onClick={handleCopy}>
                {copied ? <Check size={16} /> : <Copy size={16} />}
                <span>{copied ? ui.copied : ui.copyLink}</span>
              </button>

              <button className="action-button" type="button" onClick={handlePrint}>
                <DownloadSimple size={16} />
                <span>{ui.downloadPdf}</span>
              </button>
            </div>
          </div>

          <div className="content">
            <section className="hero" aria-labelledby="passport-title">
              <div className="hero-main">
                <span className="hero-eyebrow">{ui.eyebrow}</span>
                <div className="hero-head">
                  <h1 className="hero-title" id="passport-title">
                    {PRODUCT_NAME}
                  </h1>
                  <span className="status-pill">
                    <CheckCircle size={18} />
                    {identity.status}
                  </span>
                </div>
                <p className="hero-description">{ui.heroDescription}</p>
                <dl className="hero-identity">
                  <div>
                    <dt>{ui.dppId}</dt>
                    <dd>{identity.dppId}</dd>
                  </div>
                  <div>
                    <dt>{ui.serial}</dt>
                    <dd>{identity.serial}</dd>
                  </div>
                  <div>
                    <dt>{ui.updated}</dt>
                    <dd>{identity.updated}</dd>
                  </div>
                </dl>
              </div>

              <div className="hero-specs">
                <h2 className="specs-title">{ui.coreSpecs}</h2>
                <dl className="specs-list">
                  {metrics.map((metric) => (
                    <div className="spec" key={metric.key}>
                      <dt>{metric.label}</dt>
                      <dd>
                        <strong>{metric.value}</strong>
                        {metric.unit && <span>{metric.unit}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            </section>

            <nav className="tabs" aria-label={ui.overview}>
              {TAB_KEYS.map((key, index) => {
                const TabIcon = TAB_ICONS[key]
                const panel = panels[index]
                const selected = tab === key
                return (
                  <button
                    className="tab"
                    type="button"
                    aria-current={selected ? 'page' : undefined}
                    key={key}
                    ref={(node) => {
                      tabRefs.current[index] = node
                    }}
                    onClick={() => selectTab(key, false)}
                    onKeyDown={(event) => onTabKeyDown(event, index)}
                  >
                    <TabIcon size={18} />
                    {panel.title}
                  </button>
                )
              })}
            </nav>

            <div className="workspace">
              <section className="panel" id="passport-panel" aria-labelledby="overview-title">
                <div className="panel-head">
                  <h2 className="panel-title" id="overview-title">
                    {activePanel.title}
                  </h2>
                  <div className="search" ref={searchWrapRef}>
                    <button
                      ref={searchTriggerRef}
                      className="search-trigger"
                      type="button"
                      aria-label={ui.search}
                      aria-expanded={searchOpen}
                      onClick={() => setSearchOpen((open) => !open)}
                    >
                      <MagnifyingGlass size={19} />
                    </button>
                    {searchOpen && (
                      <div className="search-popover">
                        <MagnifyingGlass className="search-icon" size={19} />
                        <input
                          ref={searchInputRef}
                          className="search-input"
                          type="search"
                          value={search}
                          aria-label={ui.search}
                          placeholder={ui.search}
                          onChange={(event) => setSearch(event.target.value)}
                        />
                        {search && (
                          <button
                            className="search-clear"
                            type="button"
                            aria-label={ui.clear}
                            onClick={() => setSearch('')}
                          >
                            <X size={17} />
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                </div>

                <div
                  className="panel-body"
                  id={`passport-tab-panel-${tab}`}
                  role="tabpanel"
                  aria-labelledby={`passport-tab-${tab}`}
                  tabIndex={-1}
                >
                  {tab === 'health' && (
                    <div className="notice">
                      <span className="notice-icon">
                        <Pulse size={18} />
                      </span>
                      <div>
                        <div className="notice-title">{ui.liveTelemetry}</div>
                        <p className="notice-text">{ui.liveTelemetryBody}</p>
                      </div>
                    </div>
                  )}

                  {filteredSections.length > 0 ? (
                    <div className="section-list">
                      {filteredSections.map((section, index) => (
                        <SectionBlock
                          key={`${tab}-${section.title}`}
                          section={section as Section}
                          id={`section-${tab}-${index}`}
                          ui={ui}
                        />
                      ))}
                    </div>
                  ) : (
                    <div className="empty">
                      <span className="empty-icon">
                        <MagnifyingGlass size={22} />
                      </span>
                      <h4 className="empty-title">{ui.noResults}</h4>
                      <p className="empty-text">{ui.noResultsHint}</p>
                      <button className="action-button action-button--secondary" type="button" onClick={() => setSearch('')}>
                        {ui.clear}
                      </button>
                    </div>
                  )}

                  {tab === 'health' && query && matchCount === 0 && (
                    <div className="notice notice--muted">
                      <span className="notice-icon">
                        <Minus size={18} />
                      </span>
                      <p className="notice-text">{ui.awaitingHint}</p>
                    </div>
                  )}
                </div>
              </section>

            </div>

            <section className="verify" aria-label={ui.verification}>
              <div className="verify-copy">
                <span className="verify-title">
                  <CheckCircle size={19} />
                  {ui.verifiedRecord}
                </span>
                <span className="verify-facts">
                  {identity.dppId} · {ui.regulation} EU 2023/1542 · {ui.schema} v
                  {findFieldAcross(lang, '001')?.value ?? '1.2'}
                </span>
              </div>
              <div className="verify-aside">
                <QRCodeSVG
                  value={shareUrl}
                  size={88}
                  bgColor="#ffffff"
                  fgColor="#0b0c0f"
                  level="M"
                  marginSize={0}
                  title={`${ui.passport} ${identity.dppId}`}
                />
                <div>
                  <span className="verify-label">{ui.scan}</span>
                  <a className="verify-link" href={`mailto:${SUPPORT_EMAIL}`}>
                    {ui.contact}
                    <ArrowUpRight size={16} />
                  </a>
                </div>
              </div>
            </section>
          </div>

          <footer className="footer">
            <span>
              © 2026 {ui.brand} · {ui.product}
            </span>
            <span className="footer-links">
              <a href="https://www.wattsonic.com" target="_blank" rel="noreferrer noopener">
                Wattsonic.com
              </a>
              <span>EU 2023/1542</span>
            </span>
          </footer>
        </main>
      </div>

      {copied && (
        <div className="toast" role="status" aria-live="polite">
          <Check size={16} />
          {ui.copied}
        </div>
      )}

      <PrintDocument lang={lang} panels={panels} identity={identity} metrics={metrics} />
    </>
    </IconContext.Provider>
  )
}
